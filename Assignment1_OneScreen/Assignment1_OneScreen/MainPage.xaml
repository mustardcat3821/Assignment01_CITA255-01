<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns = "http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x = "http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class = "Assignment1_OneScreen.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding = "30,0"
            Spacing = "25">

            <Label
                Text = "Time Calculator"
                Style = "{StaticResource Headline}"
                SemanticProperties.HeadingLevel = "Level1" />

            <Label
                Text = "Calculate time differences with ease"
                Style = "{StaticResource SubHeadline}"
                SemanticProperties.HeadingLevel = "Level2"
                SemanticProperties.Description = "Time calculator for easy time difference calculations" />

            <Entry
                Placeholder = "Enter the amount of days"
                x:Name = "timeInput"
                Keyboard = "Numeric" />

            <Button
                x:Name = "convertButton"
                Text = "Convert"
                SemanticProperties.Hint = "Converts days to hours and minutes"
                Clicked = "OnConvertClicked"
                HorizontalOptions = "Fill" />

            <Label
                x:Name = "resultLabel"
                Text = ""
                FontSize = "18"
                HorizontalOptions = "Center" />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
